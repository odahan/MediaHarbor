<Window x:Class="MediaHarbor.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Media Harbor" Icon="Assets/MediaHarbor.ico" Width="689" Height="676" MinWidth="689" MinHeight="550" WindowStyle="None" ResizeMode="CanResizeWithGrip" AllowsTransparency="True" Background="Transparent" FontFamily="Segoe UI" FontSize="12" WindowStartupLocation="CenterScreen">
    <Window.InputBindings>
        <KeyBinding Key="V" Modifiers="Control" Command="{Binding PasteCommand}" />
        <KeyBinding Key="F" Modifiers="Control" Command="{Binding FocusSearchCommand}" />
    </Window.InputBindings>
    <Border Margin="10" CornerRadius="11" BorderThickness="1" BorderBrush="#6EB6D9" ClipToBounds="True">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
                <GradientStop Color="#32A7C9" />
                <GradientStop Offset="1" Color="#3077C9" />
            </LinearGradientBrush>
        </Border.Background>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="35" />
                <RowDefinition Height="174" />
                <RowDefinition Height="*" />
                <RowDefinition Height="70" />
            </Grid.RowDefinitions>
            <Border CornerRadius="10,10,0,0" MouseLeftButtonDown="DragTitle">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#1C78A6" />
                        <GradientStop Offset="1" Color="#063E68" />
                    </LinearGradientBrush>
                </Border.Background>
                <DockPanel Margin="14,0,6,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="{Binding Icon, RelativeSource={RelativeSource AncestorType=Window}}" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,5,0" />
                        <TextBlock Text="Media Harbor" Foreground="White" FontWeight="Bold" FontSize="20" />
                        <Button Content="⌄" Margin="8,0,0,0" Padding="4,0" Click="OpenMenu" Background="#12547D" Foreground="White">
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="History" Command="{Binding HistoryCommand}" />
                                    <MenuItem Header="Convert a file" Command="{Binding ConvertCommand}" />
                                    <MenuItem Header="Trim audio" Command="{Binding TrimCommand}" />
                                    <MenuItem Header="Settings" Command="{Binding SettingsCommand}" />
                                    <Separator />
                                    <MenuItem Header="Help" Command="{Binding HelpCommand}" />
                                    <MenuItem Header="About" Command="{Binding AboutCommand}" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="−" Click="Minimize" Padding="4,0" Margin="2,8" />
                        <Button Content="□" Click="Maximize" Padding="4,0" Margin="2,8" />
                        <Button Content="×" Click="CloseWindow" Padding="4,0" Margin="2,8" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <Border Grid.Row="1" Margin="13,19,16,13" Background="#376D9F" BorderBrush="#1D588D" BorderThickness="1" CornerRadius="4" Padding="7,5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1" />
                        <ColumnDefinition Width="1.13*" />
                        <ColumnDefinition Width="1.25*" />
                        <ColumnDefinition Width="1.18*" />
                        <ColumnDefinition Width="1.2*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="1" Margin="0,8,5,5" CornerRadius="6" Background="#E5EAF0">
                        <Grid>
                            <TextBlock Text="Choose folder" Style="{DynamicResource StepTitle}" />
                            <Button Command="{Binding ChooseFolderCommand}" Margin="12,23,12,24" Padding="0" ToolTip="Choose the download folder">
                                <Viewbox>
                                    <Canvas Width="100" Height="69">
                                        <Path Fill="#5CB7DA" Stroke="#4395BF" Data="M12,17 L12,8 Q12,5 17,5 L40,5 L47,15 L88,15 L88,61 L12,61 Z" />
                                        <Rectangle Canvas.Left="9" Canvas.Top="17" Width="81" Height="45" RadiusX="4" RadiusY="4">
                                            <Rectangle.Fill>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#7CCBE8" />
                                                    <GradientStop Color="#1876AE" Offset="1" />
                                                </LinearGradientBrush>
                                            </Rectangle.Fill>
                                        </Rectangle>
                                        <Ellipse Canvas.Left="34" Canvas.Top="24" Width="33" Height="33" Fill="#207DAF" Stroke="#B0DFED" />
                                        <Path Fill="#ADE3F3" Data="M46,30 L55,30 L55,40 L60,40 L50,50 L40,40 L46,40 Z" />
                                    </Canvas>
                                </Viewbox>
                            </Button>
                            <TextBlock Text="{Binding Folder}" TextTrimming="CharacterEllipsis" Margin="10,0,10,7" VerticalAlignment="Bottom" Foreground="#657A89" FontSize="10" ToolTip="{Binding Folder}" />
                        </Grid>
                    </Border>
                    <Border Grid.Column="2" Margin="0,8,5,5" CornerRadius="6" Background="#E8EEF4">
                        <Grid>
                            <TextBlock Text="Choose format" Style="{DynamicResource StepTitle}" />
                            <Viewbox Margin="18,27,18,28">
                                <Canvas Width="108" Height="57">
                                    <Path Stroke="#57A9CE" StrokeThickness="2" Data="M8,18 Q50,-12 94,19" HorizontalAlignment="Center" Canvas.Left="11" VerticalAlignment="Center" Canvas.Top="20" Height="9" Stretch="Fill" />
                                    <Ellipse Canvas.Left="45" Canvas.Top="27" Width="26" Height="26" Fill="#E4F1F6" />
                                    <TextBlock Text="♫" Foreground="#339FC4" Canvas.Left="87" Canvas.Top="22" FontSize="23" />
                                    <TextBlock Text="▷" Foreground="#288FB9" Canvas.Left="0" Canvas.Top="20" FontSize="26" />
                                </Canvas>
                            </Viewbox>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="5,0,5,7">
                                <TextBlock Width="66" Text="mp4" TextAlignment="Center" FontWeight="SemiBold" Foreground="#2F6F9F" ToolTip="Video format" />
                                <TextBlock Width="66" Margin="4,0,0,0" Text="mp3" TextAlignment="Center" FontWeight="SemiBold" Foreground="#2F6F9F" ToolTip="Audio format" />
                            </StackPanel>
                            <Border Margin="0,20,0,0" VerticalAlignment="Top" HorizontalAlignment="Center" Width="136" Background="#C9D8E5" BorderBrush="#9FBBD1" BorderThickness="1" CornerRadius="11" Padding="2">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Content="Video" IsChecked="{Binding IsVideo}" GroupName="Media" Width="60" Style="{DynamicResource MediaSwitchItem}" />
                                    <RadioButton Content="Audio" IsChecked="{Binding IsAudio}" GroupName="Media" Width="60" Margin="10,0,0,0" Style="{DynamicResource MediaSwitchItem}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                    <Border Grid.Column="3" Margin="0,8,5,5" CornerRadius="6" Background="#E5EBF2">
                        <Grid>
                            <TextBlock Text="Choose quality" Style="{DynamicResource StepTitle}" />
                            <Grid Margin="9,30,4,25">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="50" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
								<Viewbox Margin="0,0,2,3" Cursor="Hand" ToolTip="Click or scroll to change quality" MouseLeftButtonDown="QualityKnobNext" MouseRightButtonDown="QualityKnobPrevious" MouseWheel="QualityKnobWheel">
									<Grid Width="50" Height="50" Background="Transparent">
										<Ellipse Width="46" Height="46" Stroke="#228DB7" StrokeThickness="4">
											<Ellipse.Fill>
												<RadialGradientBrush Center="0.3,0.25" GradientOrigin="0.3,0.25">
													<GradientStop Color="White" />
													<GradientStop Color="#9BAFBF" Offset="1" />
												</RadialGradientBrush>
											</Ellipse.Fill>
										</Ellipse>
										<Grid RenderTransformOrigin="0.5,0.5">
											<Grid.Style>
												<Style TargetType="Grid">
													<Setter Property="RenderTransform">
														<Setter.Value>
															<RotateTransform Angle="0" />
														</Setter.Value>
													</Setter>
													<Style.Triggers>
														<DataTrigger Binding="{Binding Best}" Value="True">
															<Setter Property="RenderTransform">
																<Setter.Value>
																	<RotateTransform Angle="-45" />
																</Setter.Value>
															</Setter>
														</DataTrigger>
														<DataTrigger Binding="{Binding Custom}" Value="True">
															<Setter Property="RenderTransform">
																<Setter.Value>
																	<RotateTransform Angle="45" />
																</Setter.Value>
															</Setter>
														</DataTrigger>
													</Style.Triggers>
												</Style>
											</Grid.Style>
											<Ellipse Width="7" Height="7" Fill="#2FA8D8" Stroke="#1A7FAE" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" />
										</Grid>
									</Grid>
								</Viewbox>
								<Grid Grid.Column="1" VerticalAlignment="Center">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="16" />
										<ColumnDefinition Width="*" />
									</Grid.ColumnDefinitions>
									<Grid.RowDefinitions>
										<RowDefinition Height="Auto" />
										<RowDefinition Height="Auto" />
										<RowDefinition Height="Auto" />
									</Grid.RowDefinitions>
									<Grid.Resources>
										<Style x:Key="KnobOption" TargetType="RadioButton">
											<Setter Property="Foreground" Value="#3B6F8F" />
											<Setter Property="FontSize" Value="13" />
											<Setter Property="Cursor" Value="Hand" />
											<Setter Property="Template">
												<Setter.Value>
													<ControlTemplate TargetType="RadioButton">
														<ContentPresenter Margin="3,1" VerticalAlignment="Center" />
													</ControlTemplate>
												</Setter.Value>
											</Setter>
											<Style.Triggers>
												<Trigger Property="IsChecked" Value="True">
													<Setter Property="Foreground" Value="#2FA8D8" />
												</Trigger>
												<Trigger Property="IsMouseOver" Value="True">
													<Setter Property="Opacity" Value="0.8" />
												</Trigger>
											</Style.Triggers>
										</Style>
										<Style x:Key="KnobTick" TargetType="Path">
											<Setter Property="StrokeThickness" Value="2" />
											<Setter Property="VerticalAlignment" Value="Center" />
										</Style>
									</Grid.Resources>
									<Path Data="M0,8 L6,0 L16,0" VerticalAlignment="Bottom" Margin="0,0,0,8" Style="{StaticResource KnobTick}" Stroke="{Binding Foreground, ElementName=QualityBest}" />
									<Path Grid.Row="1" Data="M4,0 L16,0" Style="{StaticResource KnobTick}" Stroke="{Binding Foreground, ElementName=QualityNormal}" />
									<Path Grid.Row="2" Data="M0,0 L6,8 L16,8" VerticalAlignment="Top" Margin="0,1,0,0" Style="{StaticResource KnobTick}" Stroke="{Binding Foreground, ElementName=QualityCustom}" />
									<RadioButton x:Name="QualityBest" Grid.Column="1" Content="Best" GroupName="Quality" IsChecked="{Binding Best}" Style="{StaticResource KnobOption}" />
									<RadioButton x:Name="QualityNormal" Grid.Column="1" Grid.Row="1" Content="Normal" GroupName="Quality" IsChecked="{Binding Normal}" Style="{StaticResource KnobOption}" />
									<RadioButton x:Name="QualityCustom" Grid.Column="1" Grid.Row="2" Content="Custom" GroupName="Quality" IsChecked="{Binding Custom}" Style="{StaticResource KnobOption}" />
								</Grid>
                            </Grid>
                            <ComboBox ItemsSource="{Binding Qualities}" SelectedItem="{Binding CustomQuality}" Width="89" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,6,1" ToolTip="Compression / quality: MP3 bitrate (kbit/s) or MP4 resolution (p)">
                                <ComboBox.Visibility>
                                    <Binding Path="IsChecked" ElementName="QualityCustom">
                                        <Binding.Converter>
                                            <BooleanToVisibilityConverter />
                                        </Binding.Converter>
                                    </Binding>
                                </ComboBox.Visibility>
                            </ComboBox>
                        </Grid>
                    </Border>
                    <Border Grid.Column="4" Margin="0,8,0,5" CornerRadius="6" Background="#E5EAF0">
                        <Grid>
                            <TextBlock Text="Download" Style="{DynamicResource StepTitle}" />
                            <Border Margin="9,28,9,9" CornerRadius="12" BorderThickness="2,2,1,1" BorderBrush="#B8C2CB">
                                <Button Content="Paste URL  ⬇" Command="{Binding PasteCommand}" Background="{StaticResource ButtonBlue}" Foreground="White" FontSize="16" Margin="4,21,4,24" Padding="4,3" ToolTip="Paste links from the clipboard (Ctrl+V)" />
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
            <Border Grid.Row="2" Margin="12,4,16,0" CornerRadius="5" BorderThickness="1" BorderBrush="#4EAACB" Background="#102264A4" ClipToBounds="True">
                <Grid>
                    <Canvas IsHitTestVisible="False" Opacity="0.065">
                        <Rectangle Width="210" Height="440" Fill="White" Canvas.Left="32" Canvas.Top="70">
                            <Rectangle.RenderTransform>
                                <RotateTransform Angle="-32" />
                            </Rectangle.RenderTransform>
                        </Rectangle>
                        <Rectangle Width="170" Height="260" Stroke="White" StrokeThickness="12" Canvas.Left="355" Canvas.Top="70">
                            <Rectangle.RenderTransform>
                                <RotateTransform Angle="-32" />
                            </Rectangle.RenderTransform>
                        </Rectangle>
                        <Rectangle Width="45" Height="45" Fill="White" Canvas.Left="125" Canvas.Top="55">
                            <Rectangle.RenderTransform>
                                <RotateTransform Angle="-32" />
                            </Rectangle.RenderTransform>
                        </Rectangle>
                    </Canvas>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="53" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="25" />
                        </Grid.RowDefinitions>
                        <Border Background="#DDE7F0" Margin="6,6,7,0" CornerRadius="3" Padding="6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="91" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="?" Foreground="#8C9EA9" FontWeight="Bold" VerticalAlignment="Center" />
                                <TextBox x:Name="QueryBox" Grid.Column="1" Text="{Binding Query,UpdateSourceTrigger=PropertyChanged}" ToolTip="A video name, URL, or several links on separate lines" VerticalAlignment="Center">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                                    </TextBox.InputBindings>
                                </TextBox>
                                <TextBlock Grid.Column="1" Text="Download a video by name or paste a link" Foreground="#81929E" Margin="8,0" VerticalAlignment="Center" IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Query}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <ComboBox Grid.Column="2" Margin="5,1" ItemsSource="{Binding SearchModes}" SelectedItem="{Binding SearchMode}" ToolTip="Choose search behavior" FontSize="10" />
                                <Button Grid.Column="3" Content="Download" Command="{Binding SearchCommand}" Background="{StaticResource ButtonBlue}" Foreground="White" FontWeight="Bold" Padding="5,2" />
                            </Grid>
                        </Border>
                        <ItemsControl Grid.Row="1" Margin="6,7,6,0" ItemsSource="{Binding Jobs}"
                                      VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                      VirtualizingPanel.ScrollUnit="Pixel">
                            <ItemsControl.Template>
                                <ControlTemplate TargetType="ItemsControl">
                                    <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </ControlTemplate>
                            </ItemsControl.Template>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#EEF4F8" BorderBrush="#8EB9CF" BorderThickness="1" CornerRadius="5" Margin="0,0,0,6" Padding="9">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="40" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="93" />
                                            </Grid.ColumnDefinitions>
                                            <Border x:Name="MediaIcon" Width="33" Height="34" CornerRadius="5" Background="#349BC4" VerticalAlignment="Top">
                                                <TextBlock Text="{Binding Symbol}" Foreground="White" FontSize="21" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="7,0,8,0">
                                                <TextBlock Text="{Binding Title}" Foreground="#145078" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Url}" />
                                                <TextBlock Text="{Binding Detail}" Foreground="#667F90" FontSize="10" TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}" Margin="0,3" />
                                                <TextBlock Text="{Binding Status}" Foreground="#3B7D9D" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <Button Content="{Binding ActionLabel}" Command="{Binding ToggleCommand}" Padding="5,2" />
                                                <Button Content="More ▾" Padding="5,2" Margin="0,4,0,0" Click="OpenMenu">
                                                    <Button.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem Header="Open file" Command="{Binding OpenCommand}" />
                                                            <MenuItem Header="Show in folder" Command="{Binding RevealCommand}" />
                                                            <MenuItem Header="Copy URL" Command="{Binding CopyCommand}" />
                                                            <MenuItem Header="Download subtitles" Command="{Binding SubtitlesCommand}" />
                                                            <MenuItem Header="Remove" Command="{Binding RemoveCommand}" />
                                                        </ContextMenu>
                                                    </Button.ContextMenu>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Complete}" Value="True">
                                            <Setter TargetName="MediaIcon" Property="Background" Value="#27844A" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Failed}" Value="True">
                                            <Setter TargetName="MediaIcon" Property="Background" Value="#BD3948" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <DockPanel Grid.Row="2" Margin="10,0">
                            <TextBlock Text="{Binding Notice}" Foreground="#E6F5FC" FontSize="10" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Notice}" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Resume all" Command="{Binding ResumeAllCommand}" Padding="5,1" FontSize="10" Margin="3,0" />
                                <Button Content="Clear finished" Command="{Binding ClearCommand}" Padding="5,1" FontSize="10" />
                            </StackPanel>
                        </DockPanel>
                    </Grid>
                </Grid>
            </Border>
            <Grid Grid.Row="3" Margin="12,8,17,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                    <Border BorderBrush="#1575A1" BorderThickness="2" CornerRadius="3" Padding="3" Background="#298AB6">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="⚙" Command="{Binding SettingsCommand}" FontSize="23" Padding="6,0" ToolTip="Settings" />
                            <Button Content="?" Command="{Binding HelpCommand}" FontSize="23" FontWeight="Bold" Margin="4,0" Padding="10,0" ToolTip="Help" />
                            <Button Content="⌕" Command="{Binding HistoryCommand}" FontSize="23" Padding="8,0" ToolTip="History" />
                            <Button Command="{Binding SpeedCommand}" Margin="4,0,0,0" Padding="7,0" ToolTip="Download speed">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="◴" FontSize="25" Margin="0,0,4,0" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Speed" FontSize="9" />
                                        <TextBlock Text="{Binding SpeedLimit}" FontSize="11" />
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <CheckBox Grid.Column="1" Content="Auto detect" IsChecked="{Binding AutoDetect}" Foreground="White" VerticalAlignment="Center" FontWeight="SemiBold" ToolTip="Offer to download copied YouTube links" />
            </Grid>
        </Grid>
    </Border>
    <Window.Resources>
        <Style x:Key="StepTitle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="0,-5,0,0" />
            <Setter Property="Padding" Value="7,2" />
            <Setter Property="Background" Value="#00A1D4" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style x:Key="MediaSwitchItem" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#3F6684" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Pill" MinWidth="46" Padding="8,2" CornerRadius="8" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="#DDE8F1" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Pill" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#1C9FD4" />
                                            <GradientStop Offset="1" Color="#1876AE" />
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
</Window>
