<Application x:Class="MediaHarbor.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <LinearGradientBrush x:Key="ButtonBlue" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#BDE9FC" />
      <GradientStop Color="#2586BA" Offset="0.55" />
      <GradientStop Color="#116397" Offset="1" />
    </LinearGradientBrush>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="#174E72" />
      <Setter Property="Background" Value="#EDF5FA" />
      <Setter Property="BorderBrush" Value="#90B7CB" />
      <Setter Property="Padding" Value="10,5" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Opacity" Value="0.8" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Padding" Value="7,5" />
      <Setter Property="BorderBrush" Value="#A1B8C9" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Padding" Value="4,2" />
      <Setter Property="MinHeight" Value="25" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style TargetType="RadioButton">
      <Setter Property="Margin" Value="0,3" />
      <Setter Property="Foreground" Value="#166990" />
    </Style>
  </Application.Resources>
</Application>