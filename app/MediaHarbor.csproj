<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>MediaHarbor</AssemblyName>
    <Version>0.9.1</Version>
    <AssemblyVersion>0.9.1.0</AssemblyVersion>
    <FileVersion>0.9.1.0</FileVersion>
    <InformationalVersion>0.9.1-beta</InformationalVersion>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="MediaHarbor.Tests\**\*.cs" />
    <None Include="MediaHarbor.Tests\**\*" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="MediaHarbor.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <Content Include="tools\*.exe" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="tools\*.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <None Include="MediaHarbor.Tests\MediaHarbor.Tests.csproj" />
    <None Include="obj\knob.tmp" />
  </ItemGroup>
</Project>
